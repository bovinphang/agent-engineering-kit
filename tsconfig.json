{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "rootDir": ".", "outDir": "dist", "strict": true, "esModuleInterop": true,
    "skipLibCheck": true, "types": ["node"], "lib": ["ES2022"],
    "forceConsistentCasingInFileNames": true, "noUncheckedIndexedAccess": true
  },
  "include": ["packages/**/*.ts"], "exclude": ["dist", "node_modules"]
}
