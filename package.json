{
  "name": "agent-engineering-kit",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Evidence-driven, cross-agent AI-native software engineering workflow toolkit",
  "license": "MIT",
  "engines": {"node": ">=22"},
  "bin": {"ai-engineering": "./bin/ai-engineering.mjs", "aek": "./bin/ai-engineering.mjs"},
  "files": ["bin", "dist", "skills", "prompts", "templates", "schemas", "profiles", "docs", "README.md", "README.zh-CN.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "lint": "node scripts/lint.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {"typescript": "^5.9.3", "@types/node": "^22.0.0"}
}
